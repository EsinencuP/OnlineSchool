# Docker Compose only. Generate private values with: node infra/create-local-env.mjs
# Keep this file empty of usable credentials. Never copy cloud credentials into CI.
PG_USER=school_bootstrap
PG_PASSWORD=
APP_RUNTIME_PASSWORD=
APP_MIGRATE_PASSWORD=
CSRF_SIGNING_SECRET=
WEBAUTHN_RP_ID=
WEBAUTHN_ALLOWED_ORIGIN=
STUDENT_MANAGER_WHATSAPP=
STUDENT_MANAGER_TELEGRAM=
# STU-11: private security OTP transport. Configure through the deployment secret store.
# Verified Resend sender; no actual emails are sent by tests.
RESEND_API_KEY=
STUDENT_EMAIL_FROM=
# Exactly32 random bytes in standard base64; independent from CSRF/session secrets.
STUDENT_EMAIL_OTP_SECRET=
API_PORT=3000
HTTP_PORT=80
WORKER_MAX_ATTEMPTS=10
WORKER_RECOVERY_MAX_ATTEMPTS=10
# Configure only for synthetic accounts on a demo deployment. Empty lists deny exceptions.
# Use comma-separated AuthAccount UUIDs. Keep both flags off where real data is processed.
QA_PASSWORD_ONLY_LOGIN=false
QA_PASSWORD_ONLY_ACCOUNT_IDS=
MANAGER_PASSWORD_ONLY_LOGIN=false
MANAGER_PASSWORD_ONLY_ACCOUNT_IDS=
# Owner-requested synthetic demo switching; requires password-only mode as well.
# Ordinary accounts cannot switch to demo roles. Keep off outside the test platform.
PLATFORM_DEMO_SWITCHING=false
# Private S3-compatible storage. Keep credentials in the server environment.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Enable only in the worker after verifying private cleanup permissions and retention.
S3_UPLOAD_CLEANUP_ENABLED=false
# Malware scanning is required to confirm new homework/material uploads.
# Use a private local Unix socket or an authenticated TLS proxy to clamd.
S3_SCAN_SOCKET_PATH=
S3_SCAN_TLS_URL=
S3_SCAN_CLIENT_CERT=
S3_SCAN_CLIENT_KEY=
S3_SCAN_CA=
# VPS TLS override only:
PUBLIC_HOST=
TLS_CERT_DIR=
# Public lead form stays unavailable until all three values are configured.
PUBLIC_LEAD_ORIGIN=
PUBLIC_LEAD_MANAGER_ID=
PUBLIC_LEAD_PRIVACY_NOTICE_VERSION=
# Google Meet uses the teacher's consent. Enable only with a configured Google OAuth client and keys.
GOOGLE_MEET_OAUTH_ENABLED=false
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=
GOOGLE_MEET_ACTIVE_KEY_ID=
GOOGLE_MEET_TOKEN_KEYS=
