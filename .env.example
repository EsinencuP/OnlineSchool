# Docker Compose only. Generate private values with: node infra/create-local-env.mjs
# Keep this file empty of usable credentials. Never copy cloud credentials into CI.
PG_USER=school_bootstrap
PG_PASSWORD=
APP_RUNTIME_PASSWORD=
APP_MIGRATE_PASSWORD=
CSRF_SIGNING_SECRET=
WEBAUTHN_RP_ID=
WEBAUTHN_ALLOWED_ORIGIN=
STUDENT_MANAGER_WHATSAPP=
STUDENT_MANAGER_TELEGRAM=
API_PORT=3000
HTTP_PORT=80
WORKER_MAX_ATTEMPTS=10
WORKER_RECOVERY_MAX_ATTEMPTS=10
# Private S3-compatible storage. Server only; never expose credentials in VITE_* variables.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# VPS TLS override only:
PUBLIC_HOST=
TLS_CERT_DIR=
