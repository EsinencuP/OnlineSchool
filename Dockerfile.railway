FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@10.34.9
WORKDIR /workspace
COPY --chown=node:node . .
RUN pnpm install --frozen-lockfile \
    && pnpm --filter @online-school/api build \
    && pnpm --filter @online-school/platform build
ENV NODE_ENV=production HOST=0.0.0.0 PLATFORM_DIST_DIR=/workspace/apps/platform/dist
USER node
CMD ["sh", "-c", "node infra/railway/predeploy.mjs && exec env -u DIRECT_URL -u PLATFORM_LOCAL_DEMO_PASSWORD node apps/api/dist/main.js"]
