{
  "name": "online-school",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9 <13"
  },
  "scripts": {
    "test:k8k-staff-context": "node --test apps/api/test/staff-context.test.mjs apps/api/test/staff-context-sdk.test.mjs",
    "test:k8k-student-subjects": "node --experimental-vm-modules node_modules/jest/bin/jest.js --roots tests --runInBand --runTestsByPath tests/unit/student-subjects.test.mjs tests/unit/student-subscription-http.test.mjs",
    "k8k:baseline": "python scripts/k8k-baseline.py",
    "k8k:inventory": "node scripts/k8k-inventory.mjs",
    "k8k:baseline-ui": "node scripts/k8k-screen-baseline.mjs",
    "k8k:baseline-ui:audit": "node scripts/k8k-baseline-audit.mjs",
    "k8k:route-budget": "node scripts/k8k-route-budget.mjs",
    "k8k:design": "node scripts/k8k-design-check.mjs",
    "k8k:design:evidence": "node scripts/k8k-design-evidence.mjs",
    "k8k:typography:evidence": "node scripts/k8k-typography-evidence.mjs",
    "k8k:controls:evidence": "node scripts/k8k-controls-evidence.mjs",
    "k8k:fonts:check": "python -B scripts/k8k-font-assets.py check",
    "test:qa-password": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/qa-password-login.test.mjs tests/unit/manager-password-login.test.mjs --runInBand",
    "test:mgr11": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-leads.test.mjs tests/unit/manager-leads-http.test.mjs tests/unit/manager-leads-sdk.test.mjs --runInBand",
    "postinstall": "pnpm run generate",
    "generate": "pnpm --filter @online-school/db generate && pnpm --filter @online-school/api-contracts generate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:packages": "turbo run lint",
    "test": "turbo run test && node --test scripts/monorepo-smoke.test.mjs",
    "test:unit": "pnpm -r --if-present test:unit && node --test scripts/monorepo-smoke.test.mjs",
    "test:integration:ci": "node infra/ci/integration.mjs",
    "test:fnd:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --runInBand",
    "test:stu01": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-context.test.mjs tests/unit/student-http.test.mjs tests/unit/student-transport.test.mjs --runInBand",
    "test:mgr01": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-scope.test.mjs tests/unit/manager-http.test.mjs tests/unit/manager-architecture.test.mjs --runInBand",
    "test:mgr02": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-students.test.mjs tests/unit/manager-students-http.test.mjs tests/unit/manager-students-sdk.test.mjs --runInBand",
    "test:mgr03": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-accounts.test.mjs tests/unit/manager-accounts-http.test.mjs tests/unit/manager-accounts-sdk.test.mjs --runInBand",
    "test:mgr04": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-subscriptions.test.mjs tests/unit/manager-subscriptions-http.test.mjs tests/unit/manager-subscriptions-sdk.test.mjs --runInBand",
    "test:mgr05": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-payments.test.mjs tests/unit/manager-payments-http.test.mjs tests/unit/manager-payments-sdk.test.mjs --runInBand",
    "test:mgr06": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-schedule.test.mjs tests/unit/manager-schedule-http.test.mjs tests/unit/manager-schedule-sdk.test.mjs --runInBand",
    "test:mgr07": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-tasks.test.mjs tests/unit/manager-tasks-http.test.mjs tests/unit/manager-tasks-sdk.test.mjs --runInBand",
    "test:mgr08": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-notifications.test.mjs tests/unit/manager-notifications-http.test.mjs tests/unit/manager-notifications-sdk.test.mjs --runInBand",
    "test:mgr09": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/manager-dashboard.test.mjs tests/unit/manager-dashboard-http.test.mjs tests/unit/manager-dashboard-sdk.test.mjs --runInBand",
    "test:mgr09:load": "node scripts/mgr09-load.mjs",
    "test:stu02": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-dashboard.test.mjs tests/unit/student-dashboard-http.test.mjs --runInBand",
    "test:stu03": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-lessons.test.mjs tests/unit/student-lessons-http.test.mjs --runInBand",
    "test:stu04": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-history.test.mjs tests/unit/student-history-http.test.mjs --runInBand",
    "test:stu05": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-homework.test.mjs tests/unit/student-homework-http.test.mjs --runInBand",
    "test:stu06": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-materials.test.mjs tests/unit/student-materials-http.test.mjs --runInBand",
    "test:stu07": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-subscription.test.mjs tests/unit/student-subscription-http.test.mjs --runInBand",
    "test:fnd:ci": "node tests/support/run-foundation.mjs",
    "test:fnd:safe": "node tests/support/run-foundation.mjs --safe-only",
    "test:fnd:e2e": "playwright test --config playwright.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "pnpm --filter @online-school/db db:seed",
    "db:reset-qa": "pnpm --filter @online-school/db db:reset-qa",
    "db:migrate:dry-run": "pnpm --filter @online-school/db db:migrate:dry-run",
    "db:migrate:up": "pnpm --filter @online-school/db db:migrate:up",
    "generate:client": "pnpm --filter @online-school/api build && pnpm --filter @online-school/api export:openapi && pnpm --filter @online-school/api-contracts generate:client",
    "test:stu08": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-skills.test.mjs tests/unit/student-skills-http.test.mjs --runInBand",
    "test:stu09": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-reports.test.mjs tests/unit/student-reports-http.test.mjs tests/unit/student-reports-worker.test.mjs tests/unit/student-reports-sdk.test.mjs --runInBand",
    "test:stu10": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-notifications.test.mjs tests/unit/student-notifications-http.test.mjs tests/unit/student-notifications-sdk.test.mjs --runInBand",
    "test:stu11": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/student-security.test.mjs tests/unit/student-security-http.test.mjs tests/unit/student-security-sdk.test.mjs --runInBand",
    "test:stu12": "pnpm --filter @online-school/student-cabinet test",
    "test:stu12:a11y": "pnpm --filter @online-school/student-cabinet test:a11y",
    "k8k:overlays:evidence": "node scripts/k8k-overlays-evidence.mjs",
    "k8k:composites:evidence": "node scripts/k8k-composites-evidence.mjs",
    "k8k:tables:evidence": "node scripts/k8k-tables-evidence.mjs",
    "k8k:calendar:evidence": "node scripts/k8k-calendar-evidence.mjs",
    "k8k:states:evidence": "node scripts/k8k-states-evidence.mjs",
    "k8k:refresh:evidence": "node scripts/k8k-refresh-evidence.mjs",
    "k8k:refresh:budget": "node scripts/k8k-refresh-budget.mjs",
    "k8k:priority:evidence": "node scripts/k8k-priority-evidence.mjs",
    "k8k:priority:budget": "node scripts/k8k-refresh-budget.mjs --task-022",
    "k8k:shell:gate": "node scripts/k8k-shell-gate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.5.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "culori": "4.0.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.10",
    "stylelint": "16.26.1",
    "supertest": "7.3.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
