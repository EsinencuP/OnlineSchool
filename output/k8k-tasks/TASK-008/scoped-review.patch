+            <p data-unknown role="status">
+              <StatusChip tone="warning">
+                {ro
+                  ? 'Rezultatul nu este cunoscut. Verifică starea înainte de altă comandă.'
+                  : 'Исход неизвестен. Проверь состояние перед новой командой.'}
+              </StatusChip>
+            </p>
+          )}
