+      trigger={
+        <Button variant="ghost">{ro ? 'Despre numele afișat' : 'Об имени в кабинете'}</Button>
+      }
+    >
+      <Button variant="secondary" onClick={() => setOpen(false)}>
+        {ro ? 'Am înțeles' : 'Понятно'}
+      </Button>
+    </Dialog>
+  );
+}
