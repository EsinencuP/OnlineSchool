+  const ro = locale === 'ro';
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={setOpen}
+      title={ro ? 'Numele afișat în cabinet' : 'Имя в кабинете'}
+      description={
+        ro
+          ? 'Acest nume apare în cabinet. Datele din documentele școlii nu se modifică.'
