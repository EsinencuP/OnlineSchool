+          </Button>
+          <ConfirmDialog
+            open={discard}
+            onOpenChange={setDiscard}
+            returnFocusRef={input}
+            title={ro ? 'Renunți la modificări?' : 'Отбросить изменения?'}
+            description={
+              ro
+                ? 'Textul sintetic nesalvat va fi eliminat.'
+                : 'Несохранённый синтетический текст будет удалён.'
+            }
