NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://school:replace_me@localhost:6432/online_school
# Required for anonymous double-submit CSRF tokens (at least 32 random bytes).
# Generate locally; never commit the actual value.
CSRF_SIGNING_SECRET=
# One permanent HTTPS QA host; no wildcard, path, port or Vercel preview origin.
WEBAUTHN_RP_ID=
WEBAUTHN_ALLOWED_ORIGIN=
# Keep migration credentials in packages/db/.env, outside the API runtime.
