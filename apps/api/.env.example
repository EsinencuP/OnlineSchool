NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://school:replace_me@localhost:6432/online_school
# Required for anonymous double-submit CSRF tokens (at least 32 random bytes).
# Generate locally; never commit the actual value.
CSRF_SIGNING_SECRET=
# One permanent HTTPS QA host; no wildcard, path, port or Vercel preview origin.
WEBAUTHN_RP_ID=
WEBAUTHN_ALLOWED_ORIGIN=
# Synthetic accounts on a demo deployment only. Comma-separated AuthAccount UUIDs.
QA_PASSWORD_ONLY_LOGIN=false
QA_PASSWORD_ONLY_ACCOUNT_IDS=
MANAGER_PASSWORD_ONLY_LOGIN=false
MANAGER_PASSWORD_ONLY_ACCOUNT_IDS=
PLATFORM_DEMO_SWITCHING=false
# Keep migration credentials in packages/db/.env, outside the API runtime.
# Same-origin HTTPS public lead form and the active manager responsible for new leads.
PUBLIC_LEAD_ORIGIN=
PUBLIC_LEAD_MANAGER_ID=
PUBLIC_LEAD_PRIVACY_NOTICE_VERSION=
# Google Meet teacher OAuth. Token keys are an object mapping key identifiers to base64url 32-byte keys.
GOOGLE_MEET_OAUTH_ENABLED=false
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=
GOOGLE_MEET_ACTIVE_KEY_ID=
GOOGLE_MEET_TOKEN_KEYS=
