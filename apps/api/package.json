{
  "name": "@online-school/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./notifications": {
      "types": "./dist/modules/notifications/notification.service.d.ts",
      "import": "./dist/modules/notifications/notification.service.js"
    },
    "./homework-drafts": {
      "types": "./dist/student/homework/draft-expiry.module.d.ts",
      "import": "./dist/student/homework/draft-expiry.module.js"
    },
    "./serverless": {
      "types": "./dist/serverless.d.ts",
      "import": "./dist/serverless.js"
    },
    "./finance-expiry": {
      "types": "./dist/modules/finance/expiry.module.d.ts",
      "import": "./dist/modules/finance/expiry.module.js"
    },
    "./schedule-deadlines": {
      "types": "./dist/modules/schedule/deadline.module.d.ts",
      "import": "./dist/modules/schedule/deadline.module.js"
    },
    "./education-export": {
      "types": "./dist/student/reports/export-data.d.ts",
      "import": "./dist/student/reports/export-data.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "watch": "tsc -b --watch",
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:integration": "pnpm run build && node --test --test-concurrency=1 test/integration/*.test.mjs",
    "export:openapi": "node scripts/export-openapi.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/cache-manager": "12.0.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@online-school/api-contracts": "workspace:*",
    "@online-school/db": "workspace:*",
    "@online-school/shared": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "keyv": "5.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0"
  }
}
