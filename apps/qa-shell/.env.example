# No VITE_* secrets. All browser requests use the current origin and generated API paths.
# Vercel Root Directory: apps/qa-shell; include files outside the root directory.
# Server-only Vercel environment (never prefix these with VITE_):
DATABASE_URL=
CSRF_SIGNING_SECRET=
WEBAUTHN_RP_ID=onlineschool-xi.vercel.app
WEBAUTHN_ALLOWED_ORIGIN=https://onlineschool-xi.vercel.app
# Vercel sets VERCEL_GIT_COMMIT_SHA; for a non-Git build, provide BUILD_COMMIT_SHA.
BUILD_COMMIT_SHA=
