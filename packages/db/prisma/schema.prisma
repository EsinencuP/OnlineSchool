generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum AccountKind {
  STUDENT
  STAFF
  TEACHER
}

enum RoleCode {
  DIRECTOR
  MANAGER
  TEACHER
  STUDENT
  TECH_OPERATOR
}

enum RelationshipRole {
  PARENT
  LEGAL_GUARDIAN
  AUTHORIZED_CONTACT
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  DISPUTED
  REVOKED
}

enum MembershipStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum StudentActivationBasis {
  FULL_PAYMENT
  LIMITED_DIRECTOR_ADMISSION
}

enum MfaChallengePurpose {
  REGISTRATION
  AUTHENTICATION
  RECOVERY
}

enum LeadStage {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  TRIAL_DONE
  AWAITING_PAYMENT
  CONVERTED
  CLOSED
}

enum ContactChannel {
  CALL
  MESSAGE
  EMAIL
  OTHER
}

enum CrmTaskType {
  ATTENDANCE_DISPUTE
  RESCHEDULE_REQUEST
  MANUAL
  FOLLOW_UP
  TRIAL_FOLLOW_UP
  PAYMENT_FOLLOW_UP
}

enum CrmTaskStatus {
  IN_PROGRESS
  OPEN
  RESOLVED
  CANCELLED
}

// Owner: Student registry / Relations. Contacts never identify/deduplicate a person.
model Student {
  dashboard_revision StudentDashboardRevision?
  payment_contacts PaymentReceipt[] @relation("PaymentContactStudent")
  id               String           @id @default(uuid()) @db.Uuid
  full_name        String // PII
  birth_date       DateTime?        @db.Date // PII
  phone            String? // PII; deliberately not unique
  email            String? // PII; deliberately not unique
  archived_at      DateTime?        @db.Timestamptz(3)
  created_at       DateTime         @default(now()) @db.Timestamptz(3)
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  representative_links                    StudentRepresentativeLink[] @relation("StudentRelations")
  memberships                             HouseholdMembership[]       @relation("StudentMemberships")
  accounts                                StudentAccount[]            @relation("StudentAccounts")
  lead_links                              LeadStudentLink[]           @relation("StudentLeadLinks")
  manager_assignments                     AssignedManager[]           @relation("StudentManagers")
  contact_logs                            ContactLog[]                @relation("StudentContacts")
  crm_tasks                               CrmTask[]                   @relation("StudentTasks")
  t03_studentsubjectenrollment_student_id StudentSubjectEnrollment[]  @relation("StudentSubjectEnrollment_student_id")
  t04_homeworksubmission_student_id       HomeworkSubmission[]        @relation("HomeworkSubmission_student_id")

  @@map("students")
}

// A representative is a person, never a separate parent login.
model Representative {
  id          String    @id @default(uuid()) @db.Uuid
  full_name   String // PII
  phone       String? // PII; family members may share contacts
  email       String? // PII
  archived_at DateTime? @db.Timestamptz(3)
  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  student_links StudentRepresentativeLink[] @relation("RepresentativeRelations")
  memberships   HouseholdMembership[]       @relation("RepresentativeMemberships")
  contact_logs  ContactLog[]                @relation("RepresentativeContacts")

  @@map("representatives")
}

model StudentRepresentativeLink {
  id                   String             @id @default(uuid()) @db.Uuid
  student_id           String             @db.Uuid
  representative_id    String             @db.Uuid
  role                 RelationshipRole
  basis                String // PII: restricted legal/relationship basis, not a public document URL
  verification_status  VerificationStatus @default(PENDING)
  verified_at          DateTime?          @db.Timestamptz(3)
  verified_by_staff_id String?            @db.Uuid
  valid_from           DateTime           @default(now()) @db.Timestamptz(3)
  valid_to             DateTime?          @db.Timestamptz(3)
  created_at           DateTime           @default(now()) @db.Timestamptz(3)
  updated_at           DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  student        Student                    @relation("StudentRelations", fields: [student_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_relation_student")
  representative Representative             @relation("RepresentativeRelations", fields: [representative_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_relation_representative")
  verified_by    StaffAccount?              @relation("RelationVerifiedBy", fields: [verified_by_staff_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_relation_verifier")
  verifications  RelationshipVerification[] @relation("RelationVerifications")

  @@index([student_id, verification_status])
  @@index([representative_id])
  @@index([verified_by_staff_id])
  @@map("student_representative_links")
}

// Membership groups people; it confers neither legal authority nor account access.
model Household {
  id                  String    @id @default(uuid()) @db.Uuid
  label               String? // PII: may contain a family name
  archived_at         DateTime? @db.Timestamptz(3)
  created_by_staff_id String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(3)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  memberships HouseholdMembership[] @relation("HouseholdMembers")
  created_by  StaffAccount?         @relation("HouseholdCreator", fields: [created_by_staff_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_household_creator")

  @@map("households")
}

model HouseholdMembership {
  id                   String           @id @default(uuid()) @db.Uuid
  household_id         String           @db.Uuid
  student_id           String?          @db.Uuid
  representative_id    String?          @db.Uuid
  status               MembershipStatus @default(ACTIVE)
  valid_from           DateTime         @default(now()) @db.Timestamptz(3)
  valid_to             DateTime?        @db.Timestamptz(3)
  basis                String // PII: reason/evidence for this membership change
  recorded_by_staff_id String           @db.Uuid
  created_at           DateTime         @default(now()) @db.Timestamptz(3)
  updated_at           DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  household      Household       @relation("HouseholdMembers", fields: [household_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_membership_household")
  student        Student?        @relation("StudentMemberships", fields: [student_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_membership_student")
  representative Representative? @relation("RepresentativeMemberships", fields: [representative_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_membership_representative")
  recorded_by    StaffAccount    @relation("MembershipRecordedBy", fields: [recorded_by_staff_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_membership_recorder")

  @@unique([student_id], map: "uq_student_active_household", where: raw("status = 'ACTIVE'"))
  @@unique([household_id, representative_id], map: "uq_representative_active_household", where: raw("status = 'ACTIVE'"))
  @@index([household_id, status])
  @@index([student_id, valid_from])
  @@index([representative_id])
  @@index([recorded_by_staff_id])
  // SQL adds XOR/period checks and exclusion of overlapping student history.
  @@map("household_memberships")
}

// Historical verification results are separate from the current link projection.
model RelationshipVerification {
  id                   String             @id @default(uuid()) @db.Uuid
  link_id              String             @db.Uuid
  result               VerificationStatus
  basis                String // PII
  evidence_ref         String? // PII: opaque private evidence reference; no public/signed URL
  verified_by_staff_id String             @db.Uuid
  verified_at          DateTime           @default(now()) @db.Timestamptz(3)
  created_at           DateTime           @default(now()) @db.Timestamptz(3)
  updated_at           DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  link        StudentRepresentativeLink @relation("RelationVerifications", fields: [link_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_verification_link")
  verified_by StaffAccount              @relation("VerificationPerformedBy", fields: [verified_by_staff_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_verification_staff")

  @@index([link_id, verified_at])
  @@index([verified_by_staff_id])
  @@map("relationship_verifications")
}

// Owner: Identity / Access. Shared technical principal avoids polymorphic auth FKs.
// Profile kind is enforced by composite FKs and SQL CHECKs, not inferred from contacts.
model AuthAccount {
  slot_changes                   SlotChangeEvent[] @relation("SlotChangeAuthor")
  id                             String            @id @default(uuid()) @db.Uuid
  kind                           AccountKind
  login_id                       String            @unique // PII: authentication identifier, not a person deduplication key
  password_hash                  String? // AUTH_SECRET: hash only; never a plaintext password
  disabled_at                    DateTime?         @db.Timestamptz(3)
  recovery_registration_required Boolean           @default(false)
  created_at                     DateTime          @default(now()) @db.Timestamptz(3)
  updated_at                     DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  student_profile                 StudentAccount?         @relation("StudentAuth")
  staff_profile                   StaffAccount?           @relation("StaffAuth")
  teacher_profile                 TeacherAccount?         @relation("TeacherAuth")
  role_assignments                RoleAssignment[]        @relation("AccountRoles")
  sessions                        Session[]               @relation("AccountSessions")
  webauthn_credentials            WebAuthnCredential[]    @relation("AccountCredentials")
  mfa_challenges                  MfaChallenge[]          @relation("AccountChallenges")
  revocations                     AccessRevocation[]      @relation("AccountRevocations")
  performed_revocations           AccessRevocation[]      @relation("RevocationActor")
  recovery_authorizations         RecoveryAuthorization[] @relation("RecoverySubject")
  authorized_recoveries           RecoveryAuthorization[] @relation("RecoveryAuthorizer")
  t03_lessonchangeevent_author_id LessonChangeEvent[]     @relation("LessonChangeEvent_author_id")
  t04_s3object_uploaded_by        S3Object[]              @relation("S3Object_uploaded_by")
  t04_filepermission_granted_by   FilePermission[]        @relation("FilePermission_granted_by")
  t04_filepermission_revoked_by   FilePermission[]        @relation("FilePermission_revoked_by")
  t04_file_permission_subject     FilePermission[]        @relation("FilePermissionSubject")
  t04_fileauditlog_actor_id       FileAuditLog[]          @relation("FileAuditLog_actor_id")
  t04_auditevent_actor_id         AuditEvent[]            @relation("AuditEvent_actor_id")

  @@unique([id, kind], map: "uq_account_id_kind")
  @@map("auth_accounts")
}

model StudentAccount {
  timezone                           String                 @default("Europe/Chisinau")
  id                                 String                 @id @default(uuid()) @db.Uuid
  student_id                         String                 @db.Uuid
  account_id                         String                 @db.Uuid
  account_kind                       AccountKind            @default(STUDENT)
  activation_basis                   StudentActivationBasis
  must_change_password               Boolean                @default(true)
  // Payment and admission are now backed by financial FKs and SQL validation.
  activation_subscription_id         String                 @db.Uuid
  activation_payment_confirmation_id String                 @db.Uuid
  activation_director_admission_id   String?                @db.Uuid
  activation_confirmed_by_staff_id   String                 @db.Uuid
  activated_at                       DateTime               @db.Timestamptz(3)
  deactivated_at                     DateTime?              @db.Timestamptz(3)
  created_at                         DateTime               @default(now()) @db.Timestamptz(3)
  updated_at                         DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  student                             Student                    @relation("StudentAccounts", fields: [student_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_student_account_student")
  account                             AuthAccount                @relation("StudentAuth", fields: [account_id, account_kind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict, map: "fk_student_account_auth")
  confirmed_by                        StaffAccount               @relation("StudentActivationConfirmedBy", fields: [activation_confirmed_by_staff_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_student_activation_staff")
  activation_subscription_ref         Subscription               @relation("StudentAccount_activation_subscription_id", fields: [activation_subscription_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t03_activation_subscription")
  activation_payment_confirmation_ref PaymentReceipt             @relation("StudentAccount_activation_payment_confirmation_id", fields: [activation_payment_confirmation_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t03_activation_payment")
  activation_director_admission_ref   TemporaryAccessPermission? @relation("StudentAccount_activation_director_admission_id", fields: [activation_director_admission_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t03_activation_director")

  @@unique([account_id, account_kind], map: "uq_student_auth_profile")
  @@unique([student_id], map: "uq_student_active_account", where: raw("deactivated_at IS NULL"))
  @@index([student_id, activated_at])
  @@index([activation_confirmed_by_staff_id])
  @@index([activation_subscription_id])
  @@index([activation_payment_confirmation_id])
  @@index([activation_director_admission_id])
  @@map("student_accounts")
}

model StaffAccount {
  exception_accruals   TeacherAccrual[]      @relation("AccrualExceptionDirector")
  recorded_engagements TeacherEngagement[]   @relation("EngagementRecorder")
  recorded_tenure      TeacherTenureCredit[] @relation("TenureRecorder")
  promised_rates       TeacherRatePromise[]  @relation("RatePromiseRecorder")
  id                   String                @id @default(uuid()) @db.Uuid
  account_id           String                @db.Uuid
  account_kind         AccountKind           @default(STAFF)
  full_name            String // PII
  phone                String? // PII
  email                String? // PII
  deactivated_at       DateTime?             @db.Timestamptz(3)
  created_at           DateTime              @default(now()) @db.Timestamptz(3)
  updated_at           DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  account                                               AuthAccount                 @relation("StaffAuth", fields: [account_id, account_kind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict, map: "fk_staff_account_auth")
  created_households                                    Household[]                 @relation("HouseholdCreator")
  verified_links                                        StudentRepresentativeLink[] @relation("RelationVerifiedBy")
  verifications                                         RelationshipVerification[]  @relation("VerificationPerformedBy")
  recorded_memberships                                  HouseholdMembership[]       @relation("MembershipRecordedBy")
  activated_students                                    StudentAccount[]            @relation("StudentActivationConfirmedBy")
  granted_roles                                         RoleAssignment[]            @relation("RoleGrantedBy")
  checked_lead_links                                    LeadStudentLink[]           @relation("LeadLinkCheckedBy")
  manager_assignments                                   AssignedManager[]           @relation("AssignedStaffManager")
  contact_logs                                          ContactLog[]                @relation("ContactRecordedBy")
  assigned_tasks                                        CrmTask[]                   @relation("TaskAssignedTo")
  resolved_tasks                                        CrmTask[]                   @relation("TaskResolvedBy")
  t03_teachingassignment_assigned_by_id                 TeachingAssignment[]        @relation("TeachingAssignment_assigned_by_id")
  t03_lessonactualoutcome_confirmed_by_id               LessonActualOutcome[]       @relation("LessonActualOutcome_confirmed_by_id")
  t03_paymentreceipt_registered_by_manager_id           PaymentReceipt[]            @relation("PaymentReceipt_registered_by_manager_id")
  t03_paymentreceipt_confirmed_by_director_id           PaymentReceipt[]            @relation("PaymentReceipt_confirmed_by_director_id")
  t03_paymentdistribution_approved_by_director_id       PaymentDistribution[]       @relation("PaymentDistribution_approved_by_director_id")
  t03_temporaryaccesspermission_approved_by_director_id TemporaryAccessPermission[] @relation("TemporaryAccessPermission_approved_by_director_id")
  t03_entitlementgrant_authorized_by_id                 EntitlementGrant[]          @relation("EntitlementGrant_authorized_by_id")
  t03_entitlementconsumption_authorized_by_id           EntitlementConsumption[]    @relation("EntitlementConsumption_authorized_by_id")
  t03_entitlementadjustment_author_id                   EntitlementAdjustment[]     @relation("EntitlementAdjustment_author_id")
  t03_financialperiod_closed_by_id                      FinancialPeriod[]           @relation("FinancialPeriod_closed_by_id")
  t03_refundrecord_approved_by_director_id              RefundRecord[]              @relation("RefundRecord_approved_by_director_id")
  t03_teacheraccrual_authorized_by_id                   TeacherAccrual[]            @relation("TeacherAccrual_authorized_by_id")
  t03_payoutattempt_attempted_by_id                     PayoutAttempt[]             @relation("PayoutAttempt_attempted_by_id")
  t03_confirmedpayout_confirmed_by_id                   ConfirmedPayout[]           @relation("ConfirmedPayout_confirmed_by_id")
  t03_ledgerentry_published_by_id                       LedgerEntry[]               @relation("LedgerEntry_published_by_id")

  @@unique([account_id, account_kind], map: "uq_staff_auth_profile")
  @@map("staff_accounts")
}

model TeacherAccount {
  outcome_reports   LessonOutcomeReport[]   @relation("OutcomeReporter")
  schedule_requests ScheduleChangeRequest[] @relation("ScheduleRequester")
  engagements       TeacherEngagement[]     @relation("TeacherEngagements")
  rate_promises     TeacherRatePromise[]    @relation("TeacherRatePromises")
  id                String                  @id @default(uuid()) @db.Uuid
  account_id        String                  @db.Uuid
  account_kind      AccountKind             @default(TEACHER)
  full_name         String // PII
  phone             String? // PII
  email             String? // PII
  deactivated_at    DateTime?               @db.Timestamptz(3)
  created_at        DateTime                @default(now()) @db.Timestamptz(3)
  updated_at        DateTime                @default(now()) @updatedAt @db.Timestamptz(3)

  account                                   AuthAccount           @relation("TeacherAuth", fields: [account_id, account_kind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict, map: "fk_teacher_account_auth")
  t03_teachingassignment_teacher_id         TeachingAssignment[]  @relation("TeachingAssignment_teacher_id")
  t03_teacheravailability_teacher_id        TeacherAvailability[] @relation("TeacherAvailability_teacher_id")
  t03_lessonoccurrence_scheduled_teacher_id LessonOccurrence[]    @relation("LessonOccurrence_scheduled_teacher_id")
  t03_lessonactualoutcome_actual_teacher_id LessonActualOutcome[] @relation("LessonActualOutcome_actual_teacher_id")
  t03_teacheraccrual_teacher_id             TeacherAccrual[]      @relation("TeacherAccrual_teacher_id")
  lessons_started                           LessonOccurrence[]    @relation("LessonStartTeacher")
  t04_homeworkassignment_issued_by          HomeworkAssignment[]  @relation("HomeworkAssignment_issued_by")
  t04_homeworkdelivery_issued_by            HomeworkDelivery[]    @relation("HomeworkDelivery_issued_by")
  t04_submissionreview_reviewer_id          SubmissionReview[]    @relation("SubmissionReview_reviewer_id")
  t04_skillassessment_assessed_by           SkillAssessment[]     @relation("SkillAssessment_assessed_by")
  t04_educationreport_author_id             EducationReport[]     @relation("EducationReport_author_id")
  t04_educationreport_published_by          EducationReport[]     @relation("EducationReport_published_by")

  @@unique([account_id, account_kind], map: "uq_teacher_auth_profile")
  @@map("teacher_accounts")
}

model Role {
  id         String   @id @default(uuid()) @db.Uuid
  code       RoleCode @unique
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  assignments RoleAssignment[] @relation("RoleAssignments")

  @@map("roles")
}

model RoleAssignment {
  id                   String    @id @default(uuid()) @db.Uuid
  account_id           String    @db.Uuid
  role_id              String    @db.Uuid
  assigned_by_staff_id String?   @db.Uuid // Null only for controlled initial provisioning.
  valid_from           DateTime  @default(now()) @db.Timestamptz(3)
  valid_to             DateTime? @db.Timestamptz(3)
  created_at           DateTime  @default(now()) @db.Timestamptz(3)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  account     AuthAccount   @relation("AccountRoles", fields: [account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_assignment_account")
  role        Role          @relation("RoleAssignments", fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_assignment_role")
  assigned_by StaffAccount? @relation("RoleGrantedBy", fields: [assigned_by_staff_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_assignment_staff")

  @@unique([account_id, role_id], map: "uq_account_current_role", where: raw("valid_to IS NULL"))
  @@index([role_id])
  @@index([assigned_by_staff_id])
  @@map("role_assignments")
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  account_id      String    @db.Uuid
  token_hash      String    @unique @db.Char(64) // AUTH_SECRET: SHA-256 of opaque cookie token; never store the token.
  csrf_token_hash String?   @db.Char(64) // AUTH_SECRET
  expires_at      DateTime  @db.Timestamptz(3)
  revoked_at      DateTime? @db.Timestamptz(3)
  mfa_verified_at DateTime? @db.Timestamptz(3)
  recovery_only   Boolean   @default(false)
  last_seen_at    DateTime? @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  account     AuthAccount        @relation("AccountSessions", fields: [account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_session_account")
  challenges  MfaChallenge[]     @relation("SessionChallenges")
  revocations AccessRevocation[] @relation("SessionRevocations")

  @@unique([id, account_id], map: "uq_session_id_account")
  @@index([account_id, expires_at])
  @@index([expires_at])
  @@map("sessions")
}

model WebAuthnCredential {
  id              String    @id @default(uuid()) @db.Uuid
  account_id      String    @db.Uuid
  aaguid          String?   @db.Uuid
  credential_id   Bytes     @unique // PII: persistent credential identifier
  public_key      Bytes
  sign_count      BigInt    @default(0) // WebAuthn uint32; zero-counter authenticators require protocol-aware handling.
  transports      String[]
  backup_eligible Boolean   @default(false)
  backed_up       Boolean   @default(false)
  last_used_at    DateTime? @db.Timestamptz(3)
  revoked_at      DateTime? @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  account AuthAccount @relation("AccountCredentials", fields: [account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_credential_account")

  @@index([account_id])
  @@map("webauthn_credentials")
}

model MfaChallenge {
  id                 String              @id @default(uuid()) @db.Uuid
  account_id         String              @db.Uuid
  session_id         String?             @db.Uuid
  purpose            MfaChallengePurpose
  challenge_hash     String              @unique @db.Char(64) // AUTH_SECRET: hash of random challenge, not a replayable token
  login_binding_hash String?             @db.Char(64) // AUTH_SECRET: binds sessionless passkey login to a browser cookie
  expires_at         DateTime            @db.Timestamptz(3)
  used_at            DateTime?           @db.Timestamptz(3)
  created_at         DateTime            @default(now()) @db.Timestamptz(3)
  updated_at         DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  account AuthAccount @relation("AccountChallenges", fields: [account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_challenge_account")
  session Session?    @relation("SessionChallenges", fields: [session_id, account_id], references: [id, account_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_challenge_session_owner")

  @@index([account_id, expires_at])
  @@index([session_id, account_id])
  @@index([expires_at])
  @@map("mfa_challenges")
}

// Trusted evidence is provisioned through a maintenance role, never via an unverified HTTP boolean.
model RecoveryAuthorization {
  id                    String           @id @default(uuid()) @db.Uuid
  subject_account_id    String           @db.Uuid
  authorized_actor_id   String           @db.Uuid
  identity_evidence_ref String // PII: opaque reference to separately verified identity evidence
  owner_instruction_ref String? // PII: confirmed owner instruction for director recovery
  reason                String // PII
  verified_at           DateTime         @db.Timestamptz(3)
  expires_at            DateTime         @db.Timestamptz(3)
  created_at            DateTime         @default(now()) @db.Timestamptz(3)
  updated_at            DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  subject               AuthAccount      @relation("RecoverySubject", fields: [subject_account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recovery_subject")
  authorized_actor      AuthAccount      @relation("RecoveryAuthorizer", fields: [authorized_actor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recovery_authorizer")
  request               RecoveryRequest? @relation("RecoveryEvidence")

  @@index([subject_account_id, expires_at])
  @@map("recovery_authorizations")
}

model RecoveryRequest {
  id                   String                @id @default(uuid()) @db.Uuid
  authorization_id     String                @unique @db.Uuid
  command_operation_id String                @unique @db.Uuid
  token_hash           String                @unique @db.Char(64) // AUTH_SECRET: a one-time bootstrap proof, not backup codes
  expires_at           DateTime              @db.Timestamptz(3)
  completed_at         DateTime?             @db.Timestamptz(3)
  revoked_at           DateTime?             @db.Timestamptz(3)
  created_at           DateTime              @default(now()) @db.Timestamptz(3)
  updated_at           DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  authorization        RecoveryAuthorization @relation("RecoveryEvidence", fields: [authorization_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recovery_request_authorization")

  @@index([expires_at])
  @@map("recovery_requests")
}

model AuthRateLimit {
  id                String   @id @default(uuid()) @db.Uuid
  bucket_key        String   @unique @db.Char(64) // PII: hash of rate-limit identity; no raw address/email
  attempts          Int      @default(1)
  window_started_at DateTime @db.Timestamptz(3)
  expires_at        DateTime @db.Timestamptz(3)
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([expires_at])
  @@map("auth_rate_limits")
}

model AccessRevocation {
  id                    String   @id @default(uuid()) @db.Uuid
  account_id            String   @db.Uuid
  session_id            String?  @db.Uuid // Null means account-wide revocation.
  revoked_by_account_id String?  @db.Uuid // Null for system-initiated revocation; source/reason remain mandatory.
  reason                String // PII: restricted reason, no credentials
  source                String
  revoked_at            DateTime @default(now()) @db.Timestamptz(3)
  created_at            DateTime @default(now()) @db.Timestamptz(3)
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  account    AuthAccount  @relation("AccountRevocations", fields: [account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_revocation_account")
  session    Session?     @relation("SessionRevocations", fields: [session_id, account_id], references: [id, account_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_revocation_session_owner")
  revoked_by AuthAccount? @relation("RevocationActor", fields: [revoked_by_account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_revocation_actor")

  @@index([account_id, revoked_at])
  @@index([session_id, account_id])
  @@index([revoked_by_account_id])
  @@map("access_revocations")
}

// Owner: CRM / Intake. No account FK: a lead never grants login or paid rights.
model Lead {
  id          String    @id @default(uuid()) @db.Uuid
  stage       LeadStage @default(NEW)
  full_name   String // PII: incoming contact name, not a Student identity key
  phone       String? // PII; deliberately not unique
  email       String? // PII; deliberately not unique
  source      String?
  archived_at DateTime? @db.Timestamptz(3)
  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  student_links       LeadStudentLink[] @relation("LeadStudentLinks")
  manager_assignments AssignedManager[] @relation("LeadManagers")
  contact_logs        ContactLog[]      @relation("LeadContacts")
  tasks               CrmTask[]         @relation("LeadTasks")

  @@index([stage, created_at])
  @@index([phone])
  @@index([email])
  @@map("leads")
}

model LeadStudentLink {
