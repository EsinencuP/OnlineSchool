model CrmTask {
  lesson_id            String?       @db.Uuid
  payload              Json?
  lesson               LessonOccurrence? @relation("StudentRescheduleTasks", fields: [lesson_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_crm_task_lesson")
  id                   String        @id @default(uuid()) @db.Uuid
  lead_id              String?       @db.Uuid
  student_id           String?       @db.Uuid
  assigned_manager_id  String?       @db.Uuid
  type                 CrmTaskType
  status               CrmTaskStatus @default(OPEN)
  title                String // PII: restricted task description
  due_at               DateTime      @db.Timestamptz(3)
  resolved_at          DateTime?     @db.Timestamptz(3)
  resolved_by_staff_id String?       @db.Uuid
  source_event_id      String?       @db.Uuid // Source event; multiple derived tasks may share it.
  idempotency_key      String?       @unique // Stable key per derived task; one event may yield several tasks.
  created_at           DateTime      @default(now()) @db.Timestamptz(3)
  updated_at           DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  lead             Lead?         @relation("LeadTasks", fields: [lead_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_task_lead")
  student          Student?      @relation("StudentTasks", fields: [student_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_task_student")
  assigned_to      StaffAccount? @relation("TaskAssignedTo", fields: [assigned_manager_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_task_assigned_staff")
  resolved_by      StaffAccount? @relation("TaskResolvedBy", fields: [resolved_by_staff_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_task_resolved_staff")
  source_event_ref OutboxEvent?  @relation("CrmTaskOutbox", fields: [source_event_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_crm_source_event")

  @@index([assigned_manager_id, status, due_at])
  @@index([lead_id])
  @@index([student_id])
  @@index([resolved_by_staff_id])
  @@index([source_event_id])
  @@index([lesson_id])
  @@unique([student_id, lesson_id], map: "uq_open_attendance_dispute", where: raw("type = 'ATTENDANCE_DISPUTE' AND status IN ('OPEN','IN_PROGRESS')"))
  @@map("crm_tasks")
}

// TASK-03: scheduling, quantitative rights and the universal money ledger.

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum LessonStatus {
  SCHEDULED
  STAR_PENDING
  CONDUCTED
  CANCELLED
  DISPUTED
}

enum GrantBasis {
  CONFIRMED_PAYMENT
}

enum ConsumptionBasis {
  CONFIRMED_LESSON
  APPROVED_CANCELLATION
}

enum EntitlementAdjustmentKind {
  GRANT_DELTA
  CONSUMPTION_CANCELLATION
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerAccountType {
  UNALLOCATED_FUNDS
  CASH
  CUSTOMER_ADVANCE
  LESSON_REVENUE
  TEACHER_EXPENSE
  TEACHER_PAYABLE
  REFUND_PAYABLE
  CORRECTION
}

enum AccrualRateBasis {
  ORDINARY_POINTS
  INDIVIDUAL_PROMISE
  FINANCIAL_EXCEPTION
}

enum PayoutAttemptStatus {
  PENDING
  UNKNOWN
  FAILED
  SUCCEEDED
  RETURNED
}

