enum ReportedLessonResult {
  CONDUCTED
  NOT_CONDUCTED
  DISPUTED
}

enum ScheduleRequestStatus {
  PENDING
  RESOLVED
}

model LessonOutcomeReport {
  student_no_show     Boolean              @default(false)
  resolved_lesson      LessonOccurrence?    @relation("ResolvedLessonReport")
  id                   String               @id @default(uuid()) @db.Uuid
  lesson_occurrence_id String               @db.Uuid
  reported_by_id       String               @db.Uuid
  version              Int
  lesson_version       Int
  result               ReportedLessonResult
  actual_started_at    DateTime?            @db.Timestamptz(3)
  duration_min         Int?
  note                 String // PII: private teacher report
  reported_at          DateTime             @db.Timestamptz(3)
  source_operation_id  String               @unique @db.Uuid
  created_at           DateTime             @default(now()) @db.Timestamptz(3)
  updated_at           DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  lesson_ref           LessonOccurrence     @relation("LessonReports", fields: [lesson_occurrence_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_report_lesson")
  reporter_ref         TeacherAccount       @relation("OutcomeReporter", fields: [reported_by_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_report_teacher")
  confirmed_outcome    LessonActualOutcome? @relation("ConfirmedReport")

  @@unique([lesson_occurrence_id, version], map: "uq_outcome_report_version")
  @@index([reported_by_id])
  @@map("lesson_outcome_reports")
}

model ScheduleChangeRequest {
  id                   String                @id @default(uuid()) @db.Uuid
  lesson_occurrence_id String?               @db.Uuid
  recurring_slot_id    String?               @db.Uuid
  teacher_id           String                @db.Uuid
  requested_start_at   DateTime?             @db.Timestamptz(3)
  requested_end_at     DateTime?             @db.Timestamptz(3)
  reason               String // PII: private organizational request
  status               ScheduleRequestStatus @default(PENDING)
  source_operation_id  String                @unique @db.Uuid
  created_at           DateTime              @default(now()) @db.Timestamptz(3)
  updated_at           DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  lesson_ref           LessonOccurrence?     @relation("LessonRequests", fields: [lesson_occurrence_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_schedule_request_lesson")
  slot_ref             RecurringSlot?        @relation("SlotChangeRequests", fields: [recurring_slot_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_schedule_request_slot")
  teacher_ref          TeacherAccount        @relation("ScheduleRequester", fields: [teacher_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_schedule_request_teacher")

  @@index([lesson_occurrence_id])
  @@index([recurring_slot_id])
  @@index([teacher_id, status])
  @@map("schedule_change_requests")
}

model SlotChangeEvent {
  id                  String        @id @default(uuid()) @db.Uuid
  slot_id             String        @db.Uuid
  author_id           String        @db.Uuid
  old_values          Json
  new_values          Json
  reason              String
  effective_at        DateTime      @db.Timestamptz(3)
  server_recorded_at  DateTime      @default(now()) @db.Timestamptz(3)
  source_operation_id String        @unique @db.Uuid
  created_at          DateTime      @default(now()) @db.Timestamptz(3)
  updated_at          DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  slot_ref            RecurringSlot @relation("SlotChanges", fields: [slot_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_slot_change_slot")
  author_ref          AuthAccount   @relation("SlotChangeAuthor", fields: [author_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_slot_change_author")

  @@index([slot_id])
  @@index([author_id])
  @@map("slot_change_events")
}
