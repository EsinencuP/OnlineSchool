  file          S3Object           @relation(fields: [file_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([submission_id, file_id])
  @@index([file_id])
  @@map("homework_submission_attachments")
}

model HomeworkAssignmentAttachment {
  assignment_id String             @db.Uuid
  file_id       String             @db.Uuid
  assignment    HomeworkAssignment @relation(fields: [assignment_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  file          S3Object           @relation(fields: [file_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([assignment_id, file_id])
  @@index([file_id])
  @@map("homework_assignment_attachments")
}

model FilePermission {
  // subject_id below is the recipient AuthAccount, not the educational subject.
  educational_subject_id String? @db.Uuid
  lesson_occurrence_id String? @db.Uuid
  lesson_title String? // Optional teacher-supplied display title for the linked lesson
  educational_subject Subject? @relation("MaterialSubject", fields: [educational_subject_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stu06_material_subject")
  lesson_occurrence LessonOccurrence? @relation("MaterialLesson", fields: [lesson_occurrence_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stu06_material_lesson")
  id                             String         @id @default(uuid()) @db.Uuid
  s3_object_id                   String         @db.Uuid
  subject_id                     String         @db.Uuid
  subject_type                   AccountKind
  granted_by                     String         @db.Uuid
  granted_at                     DateTime       @default(now()) @db.Timestamptz(3)
  can_download                   Boolean        @default(false)
  expires_at                     DateTime?      @db.Timestamptz(3)
  revoked_at                     DateTime?      @db.Timestamptz(3)
  revoked_by                     String?        @db.Uuid
  source_operation_id            String         @unique @db.Uuid
  created_at                     DateTime       @default(now()) @db.Timestamptz(3)
  updated_at                     DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  s3_object_ref                  S3Object       @relation("FilePermission_s3_object_id", fields: [s3_object_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_file_permission_s3_object")
  granted_by_ref                 AuthAccount    @relation("FilePermission_granted_by", fields: [granted_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_file_permission_granted_by")
  revoked_by_ref                 AuthAccount?   @relation("FilePermission_revoked_by", fields: [revoked_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_file_permission_revoked_by")
  subject_ref                    AuthAccount    @relation("FilePermissionSubject", fields: [subject_id, subject_type], references: [id, kind], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_permission_subject")
  t04_fileauditlog_permission_id FileAuditLog[] @relation("FileAuditLog_permission_id")

  @@unique([s3_object_id, subject_id, subject_type], map: "uq_active_file_permission", where: raw("revoked_at IS NULL"))
  @@index([s3_object_id])
  @@index([granted_by])
  @@index([revoked_by])
  @@index([expires_at])
  @@index([subject_id, subject_type])
  @@index([subject_id, subject_type, educational_subject_id, granted_at], map: "idx_stu06_student_materials")
  @@index([lesson_occurrence_id])
  @@map("file_permissions")
}

model FileAuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  s3_object_id   String          @db.Uuid
  permission_id  String?         @db.Uuid
  action         FileAuditAction
  actor_id       String          @db.Uuid
  at             DateTime        @default(now()) @db.Timestamptz(3)
  result         AuditResult
  request_id     String          @db.Uuid
  event_key      String          @unique
  created_at     DateTime        @default(now()) @db.Timestamptz(3)
  updated_at     DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  s3_object_ref  S3Object        @relation("FileAuditLog_s3_object_id", fields: [s3_object_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_file_audit_log_s3_object")
  permission_ref FilePermission? @relation("FileAuditLog_permission_id", fields: [permission_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_file_audit_log_permission")
  actor_ref      AuthAccount     @relation("FileAuditLog_actor_id", fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_file_audit_log_actor")

  @@index([s3_object_id])
  @@index([permission_id])
  @@index([actor_id])
  @@map("file_audit_logs")
}

model AuditEvent {
  id                             String         @id @default(uuid()) @db.Uuid
  actor_id                       String?        @db.Uuid
  actor_kind                     AuditActorKind
  system_actor_ref               String?
  action                         String
  resource_type                  String
  resource_id                    String?
  result                         AuditResult
  request_id                     String         @db.Uuid
  source_operation_id            String?        @db.Uuid
  event_key                      String         @unique
  metadata                       Json?
  recorded_at                    DateTime       @default(now()) @db.Timestamptz(3)
  created_at                     DateTime       @default(now()) @db.Timestamptz(3)
  updated_at                     DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  actor_ref                      AuthAccount?   @relation("AuditEvent_actor_id", fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_audit_event_actor")
