model IdempotencyRecord {
  id           String            @id @default(uuid()) @db.Uuid
  scope        String
  key          String            @db.VarChar(200)
  command_type String
  request_hash String            @db.Char(64)
  status       IdempotencyStatus @default(IN_PROGRESS)
  result_hash  String?           @db.Char(64)
  result       Json?
  completed_at DateTime?         @db.Timestamptz(3)
  expires_at   DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP + '48:00:00'::interval)")) @db.Timestamptz(3)
  created_at   DateTime          @default(now()) @db.Timestamptz(3)
  updated_at   DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([scope, command_type, key], map: "uq_idempotency_scope_command_key")
  @@index([expires_at])
  @@map("idempotency_records")
}

model OutboxEvent {
  id                                   String       @id @default(uuid()) @db.Uuid
  status                               OutboxStatus @default(PENDING)
  topic                                String
  schema_version                       Int          @default(1)
  aggregate_type                       String
  aggregate_id                         String       @db.Uuid
  source_operation_id                  String       @db.Uuid
  audit_event_id                       String       @db.Uuid
  event_key                            String       @unique
  payload                              Json
  published_at                         DateTime?    @db.Timestamptz(3)
  attempts                             Int          @default(0)
  last_attempt_at                      DateTime?    @db.Timestamptz(3)
  next_attempt_at                      DateTime     @default(now()) @db.Timestamptz(3)
  locked_by                            String?
  locked_until                         DateTime?    @db.Timestamptz(3)
  delivery_reference                   String?
  last_error_code                      String?
  created_at                           DateTime     @default(now()) @db.Timestamptz(3)
  updated_at                           DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  audit_event_ref                      AuditEvent   @relation("OutboxEvent_audit_event_id", fields: [audit_event_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_outbox_event_audit_event")
  t04_jobrecord_source_outbox_event_id JobRecord[]  @relation("JobRecord_source_outbox_event_id")
  crm_tasks                            CrmTask[]    @relation("CrmTaskOutbox")

  @@index([audit_event_id])
  @@index([published_at, next_attempt_at])
  @@index([status, next_attempt_at])
  @@index([source_operation_id])
  @@map("outbox_events")
}

model JobRecord {
  id                       String          @id @default(uuid()) @db.Uuid
  type                     String
  status                   JobStatus       @default(PENDING)
  payload                  Json
  source_operation_id      String          @db.Uuid
  source_outbox_event_id   String?         @db.Uuid
  deduplication_key        String          @unique
  retry_policy             JobRetryPolicy
  attempts                 Int             @default(0)
  max_attempts             Int
  next_run_at              DateTime        @default(now()) @db.Timestamptz(3)
  locked_by                String?
  locked_until             DateTime?       @db.Timestamptz(3)
  started_at               DateTime?       @db.Timestamptz(3)
  finished_at              DateTime?       @db.Timestamptz(3)
  last_error_code          String?
  created_at               DateTime        @default(now()) @db.Timestamptz(3)
  updated_at               DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  source_outbox_event_ref  OutboxEvent?    @relation("JobRecord_source_outbox_event_id", fields: [source_outbox_event_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_job_record_source_outbox_event")
  t04_jobattempt_job_id    JobAttempt[]    @relation("JobAttempt_job_id")
  t04_recoverystate_job_id RecoveryState[] @relation("RecoveryState_job_id")

  @@index([source_outbox_event_id])
  @@index([status, next_run_at])
  @@index([source_operation_id])
  @@map("job_records")
}

model JobAttempt {
  id                  String           @id @default(uuid()) @db.Uuid
  job_id              String           @db.Uuid
  attempt_no          Int
  started_at          DateTime         @db.Timestamptz(3)
  finished_at         DateTime?        @db.Timestamptz(3)
  result              JobAttemptResult @default(RUNNING)
  error               String? // Sanitized error code only; no provider payload, secret or stack trace.
  provider_request_id String?
  created_at          DateTime         @default(now()) @db.Timestamptz(3)
  updated_at          DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  job_ref             JobRecord        @relation("JobAttempt_job_id", fields: [job_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_job_attempt_job")

  @@unique([job_id, attempt_no], map: "uq_job_attempt_number")
  @@index([job_id])
  @@map("job_attempts")
}

model RecoveryState {
  id                  String         @id @default(uuid()) @db.Uuid
  job_id              String         @db.Uuid
  attempt_no          Int
  operation_key       String         @unique
  provider            String
  provider_request_id String
  ext_resource_id     String?
  status              RecoveryStatus @default(PENDING)
  check_attempts      Int            @default(0)
  locked_by           String?
  locked_until        DateTime?      @db.Timestamptz(3)
  last_checked_at     DateTime?      @db.Timestamptz(3)
  next_check_at       DateTime?      @db.Timestamptz(3)
  reconciled_at       DateTime?      @db.Timestamptz(3)
  evidence_ref        String?
  reason_code         String?
  created_at          DateTime       @default(now()) @db.Timestamptz(3)
  updated_at          DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  job_ref             JobRecord      @relation("RecoveryState_job_id", fields: [job_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t04_recovery_state_job")

  @@unique([job_id, attempt_no], map: "uq_recovery_job_attempt")
  @@index([provider, provider_request_id])
  @@index([status, next_check_at])
  @@map("recovery_states")
}

// Process liveness only; not evidence that the outbox is drained or a release gate passed.
model RuntimeHeartbeat {
  instance_id  String    @id
  component    String    @default("worker")
  last_seen_at DateTime  @default(now()) @db.Timestamptz(3)
  stopped_at   DateTime? @db.Timestamptz(3)

  @@index([component, last_seen_at])
  @@map("runtime_heartbeats")
}

// HR facts are recorded by a director/controlled maintenance, not supplied as a payroll KPI by the client.
