  confirmed_report_ref                            LessonOutcomeReport?     @relation("ResolvedLessonReport", fields: [confirmed_report_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_lesson_confirmed_report")
  occurrence_date                                 DateTime?                @db.Date
  outcome_reports                                 LessonOutcomeReport[]    @relation("LessonReports")
  schedule_requests                               ScheduleChangeRequest[]  @relation("LessonRequests")
  rate_context_snapshot                           Json? // Inputs/evidence of the rate quote frozen at actual start.
  // Written at actual start; confirmation/accrual must reuse this immutable snapshot.
  actual_start_at                                 DateTime?                @db.Timestamptz(3)
  actual_teacher_at_start_id                      String?                  @db.Uuid
  rate_at_start_snapshot                          Decimal?                 @db.Decimal(20, 4)
  points_at_start_snapshot                        Int?
  rate_basis_at_start                             AccrualRateBasis?
  rate_currency_at_start                          String?                  @db.VarChar(3)
  actual_teacher_at_start_ref                     TeacherAccount?          @relation("LessonStartTeacher", fields: [actual_teacher_at_start_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t03_lesson_start_teacher")
  id                                              String                   @id @default(uuid()) @db.Uuid
  enrollment_id                                   String                   @db.Uuid
  teaching_assignment_id                          String                   @db.Uuid
  recurring_slot_id                               String?                  @db.Uuid
  scheduled_teacher_id                            String                   @db.Uuid
  original_scheduled_at                           DateTime                 @db.Timestamptz(3)
  scheduled_at                                    DateTime                 @db.Timestamptz(3)
  scheduled_end_at                                DateTime                 @db.Timestamptz(3)
  status                                          LessonStatus             @default(SCHEDULED)
  version                                         Int                      @default(1)
  source_operation_id                             String                   @unique @db.Uuid
  created_at                                      DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at                                      DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  enrollment_ref                                  StudentSubjectEnrollment @relation("LessonOccurrence_enrollment_id", fields: [enrollment_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t03_lesson_occurrence_enrollment")
  teaching_assignment_ref                         TeachingAssignment       @relation("LessonOccurrence_teaching_assignment_id", fields: [teaching_assignment_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t03_lesson_occurrence_teaching_assignment")
  recurring_slot_ref                              RecurringSlot?           @relation("LessonOccurrence_recurring_slot_id", fields: [recurring_slot_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t03_lesson_occurrence_recurring_slot")
  scheduled_teacher_ref                           TeacherAccount           @relation("LessonOccurrence_scheduled_teacher_id", fields: [scheduled_teacher_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_t03_lesson_occurrence_scheduled_teacher")
  t03_lessonchangeevent_lesson_occurrence_id      LessonChangeEvent[]      @relation("LessonChangeEvent_lesson_occurrence_id")
  t03_lessonactualoutcome_lesson_occurrence_id    LessonActualOutcome?     @relation("LessonActualOutcome_lesson_occurrence_id")
  t03_entitlementconsumption_lesson_occurrence_id EntitlementConsumption[] @relation("EntitlementConsumption_lesson_occurrence_id")
  t04_homeworkassignment_lesson_occurrence_id     HomeworkAssignment[]     @relation("HomeworkAssignment_lesson_occurrence_id")
  t04_skillassessment_lesson_ref                  SkillAssessment[]        @relation("SkillAssessment_lesson_ref")

  @@unique([recurring_slot_id, occurrence_date], map: "uq_slot_occurrence_day")
  @@unique([recurring_slot_id, original_scheduled_at], map: "uq_recurring_lesson_origin")
  @@index([enrollment_id])
  @@index([teaching_assignment_id])
  @@index([recurring_slot_id])
  @@index([scheduled_teacher_id])
  @@index([scheduled_teacher_id, scheduled_at])
  @@index([actual_teacher_at_start_id])
  @@map("lesson_occurrences")
}

