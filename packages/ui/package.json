{
  "name": "@online-school/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0 && pnpm lint:css",
    "lint:css": "node ../../scripts/k8k-stylelint.mjs",
    "test:design": "node ../../scripts/k8k-design-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:locale:types": "tsc --ignoreConfig --noEmit --strict --target es2023 --module nodenext tests/locale-types.ts",
    "test:locale:browser": "node tests/browser/locale-smoke.mjs",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --ci --disable-telemetry --no-version-updates",
    "build:storybook": "storybook build --output-dir dist/storybook --disable-telemetry",
    "check:storybook": "tsc -p tsconfig.storybook.json && node stories/check-coverage.mjs",
    "test:storybook": "node stories/smoke.mjs",
    "test:storybook:chunks": "node stories/check-app-chunks.mjs",
    "test:foundation": "node stories/foundation-gate.mjs",
    "test:foundation:budget": "node ../../scripts/k8k-foundation-budget.mjs"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "5.2.8",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tanstack/react-table": "8.21.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "storybook": "10.6.3",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  }
}
